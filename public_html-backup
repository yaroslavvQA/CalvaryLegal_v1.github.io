<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Calvary International Law PLLC | Sophisticated Cross-Border Legal Counsel</title>
  <meta name="description" content="Calvary International Law PLLC provides sophisticated international tax, estate planning, and cross-border legal counsel for families, founders, and institutions operating across jurisdictions worldwide."/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Jost:wght@200;300;400;500&display=swap" rel="stylesheet"/>

  <style>
    :root {
      --burgundy:     #5C1A2B;
      --burgundy-mid: #7A2438;
      --burgundy-lt:  #9B3A50;
      --gold:         #BFA16A;
      --gold-lt:      #D4BC8C;
      --gold-pale:    #EDE3CC;
      --cream:        #F8F4ED;
      --ink:          #1A1008;
      --ink-soft:     #3D2B1F;
      --rule:         rgba(191,161,106,0.3);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 16px; }
    body {
      background: var(--cream);
      color: var(--ink);
      font-family: 'Jost', sans-serif;
      font-weight: 300;
      overflow-x: hidden;
    }

    /* ── CURSOR ── */
    body { cursor: none; }
    #cursor {
      position: fixed; width: 10px; height: 10px; border-radius: 50%;
      background: var(--gold); pointer-events: none; z-index: 9999;
      transform: translate(-50%,-50%);
      transition: width 0.2s, height 0.2s, background 0.2s;
    }
    #cursor-ring {
      position: fixed; width: 36px; height: 36px; border-radius: 50%;
      border: 1px solid var(--gold); pointer-events: none; z-index: 9998;
      transform: translate(-50%,-50%);
      transition: width 0.3s, height 0.3s, opacity 0.3s;
    }

    /* ── NAV ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 5vw;
      height: 72px;
      background: rgba(248,244,237,0.94);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--rule);
      transition: height 0.3s;
    }
    .nav-logo {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 500; font-size: 1.25rem; letter-spacing: 0.04em;
      color: var(--burgundy); text-decoration: none;
    }
    .nav-logo span { color: var(--gold); }
    .nav-links { display: flex; gap: 2.5rem; list-style: none; }
    .nav-links a {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--ink-soft); text-decoration: none; transition: color 0.2s;
    }
    .nav-links a:hover, .nav-links a.active { color: var(--burgundy); }
    .nav-cta {
      font-family: 'Jost', sans-serif; font-weight: 400;
      font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--cream); background: var(--burgundy); border: none;
      padding: 0.6rem 1.5rem; text-decoration: none; transition: background 0.2s;
    }
    .nav-cta:hover { background: var(--burgundy-mid); }
    .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; }
    .hamburger span { width: 24px; height: 1px; background: var(--burgundy); display: block; }
    .mobile-nav {
      display: none; position: fixed;
      top: 72px; left: 0; right: 0; bottom: 0;
      background: var(--cream); z-index: 99;
      padding: 3rem 6vw; flex-direction: column; gap: 2rem;
    }
    .mobile-nav.open { display: flex; }
    .mobile-nav a {
      font-family: 'Cormorant Garamond', serif; font-size: 2rem;
      color: var(--burgundy); text-decoration: none;
    }

    .gold-line {
      width: 100%; height: 3px;
      background: linear-gradient(90deg, var(--burgundy), var(--gold), var(--burgundy));
      margin-top: 72px;
    }

    /* ── HERO ── */
    .hero {
      background: var(--ink);
      min-height: 92vh;
      padding: 10rem 8vw 8rem;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
    }
    .hero::before {
      content: '';
      position: absolute; inset: 0;
      background: repeating-linear-gradient(
        45deg, transparent, transparent 40px,
        rgba(191,161,106,0.04) 40px, rgba(191,161,106,0.04) 41px
      );
    }
    .hero-bg-text {
      position: absolute;
      bottom: -4rem; right: -3rem;
      font-family: 'Cormorant Garamond', serif;
      font-size: 26vw; font-weight: 300;
      color: rgba(191,161,106,0.035);
      line-height: 1; user-select: none; pointer-events: none;
    }
    .hero-content { position: relative; z-index: 1; max-width: 860px; }
    .hero-eyebrow {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.65rem; letter-spacing: 0.35em; text-transform: uppercase;
      color: var(--gold); margin-bottom: 2.5rem;
      display: flex; align-items: center; gap: 1rem;
    }
    .hero-eyebrow::before { content: ''; width: 48px; height: 1px; background: var(--gold); }
    .hero h1 {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 300; line-height: 1.06;
      font-size: clamp(3rem, 6vw, 6.5rem);
      color: var(--gold-pale); margin-bottom: 2.5rem;
    }
    .hero h1 em { font-style: italic; color: var(--gold); }
    .hero-sub {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 1.05rem; line-height: 1.9;
      color: rgba(237,227,204,0.6); max-width: 52ch; margin-bottom: 3rem;
    }
    .hero-actions { display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: center; }
    .btn-primary {
      font-family: 'Jost', sans-serif; font-weight: 400;
      font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--cream); background: var(--burgundy);
      padding: 1.1rem 2.5rem; text-decoration: none;
      transition: background 0.2s, transform 0.2s; display: inline-block;
      white-space: nowrap;
    }
    .btn-primary:hover { background: var(--burgundy-mid); transform: translateY(-2px); }
    .btn-ghost {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--gold); border: 1px solid rgba(191,161,106,0.4);
      padding: 1.1rem 2.5rem; text-decoration: none;
      transition: border-color 0.2s, color 0.2s; display: inline-block;
    }
    .btn-ghost:hover { border-color: var(--gold); color: var(--gold-lt); }
    .hero-scroll {
      position: absolute; bottom: 3rem; left: 8vw;
      display: flex; align-items: center; gap: 1rem;
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.6rem; letter-spacing: 0.25em; text-transform: uppercase;
      color: rgba(191,161,106,0.4);
    }
    .hero-scroll::after {
      content: ''; width: 48px; height: 1px; background: rgba(191,161,106,0.3);
      animation: scrollline 2s ease-in-out infinite;
    }
    @keyframes scrollline { 0%,100%{opacity:0.3} 50%{opacity:1} }

    /* ── CREDENTIAL STRIP ── */
    .credential-strip {
      background: white;
      border-top: 1px solid var(--rule);
      border-bottom: 1px solid var(--rule);
      padding: 2rem 8vw;
      display: flex; gap: 4vw; align-items: center; flex-wrap: wrap;
    }
    .credential-item {
      display: flex; align-items: center; gap: 0.75rem;
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.72rem; letter-spacing: 0.1em; color: var(--ink-soft);
    }
    .credential-item::before {
      content: ''; width: 6px; height: 6px;
      background: var(--gold); border-radius: 50%; flex-shrink: 0;
    }

    /* ── SECTIONS ── */
    section { padding: 7rem 8vw; }
    .section-label {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.62rem; letter-spacing: 0.3em; text-transform: uppercase;
      color: var(--gold); margin-bottom: 1.5rem;
      display: flex; align-items: center; gap: 1rem;
    }
    .section-label::before { content: ''; width: 32px; height: 1px; background: var(--gold); }
    h2.section-title {
      font-family: 'Cormorant Garamond', serif; font-weight: 300;
      font-size: clamp(2rem, 3vw, 3.5rem); line-height: 1.15;
      color: var(--burgundy); margin-bottom: 1.5rem;
    }
    p.section-intro {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 1rem; line-height: 1.9;
      color: var(--ink-soft); max-width: 60ch; margin-bottom: 4rem;
    }

    /* ── SERVICES ── */
    #services { background: var(--cream); }
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2px;
    }
    .service-card {
      background: white;
      padding: 3rem 2.5rem;
      border-top: 3px solid var(--gold);
      position: relative; overflow: hidden;
      transition: transform 0.3s, box-shadow 0.3s;
    }
    .service-card::after {
      content: '';
      position: absolute; bottom: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, var(--burgundy), var(--gold));
      transform: scaleX(0); transform-origin: left;
      transition: transform 0.4s;
    }
    .service-card:hover::after { transform: scaleX(1); }
    .service-card:hover { transform: translateY(-5px); box-shadow: 0 20px 60px rgba(92,26,43,0.08); }
    .service-num {
      font-family: 'Cormorant Garamond', serif;
      font-size: 3rem; font-weight: 300;
      color: rgba(92,26,43,0.08); line-height: 1; margin-bottom: 1.2rem;
    }
    .service-title {
      font-family: 'Cormorant Garamond', serif; font-size: 1.5rem;
      color: var(--burgundy); margin-bottom: 1rem; line-height: 1.3;
    }
    .service-desc {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.87rem; line-height: 1.85; color: var(--ink-soft);
      margin-bottom: 1.5rem;
    }
    .service-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .service-tag {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--burgundy); border: 1px solid var(--rule);
      padding: 0.2rem 0.6rem;
    }
    .service-link {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-family: 'Jost', sans-serif; font-weight: 400;
      font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase;
      color: var(--burgundy); text-decoration: none;
      margin-top: 1.5rem; transition: gap 0.2s;
    }
    .service-link::after { content: '→'; transition: transform 0.2s; }
    .service-link:hover { gap: 0.8rem; }

    /* ── APPROACH ── */
    #approach { background: var(--ink); }
    #approach h2.section-title { color: var(--gold-pale); }
    #approach .section-label { color: var(--gold); }
    #approach p.section-intro { color: rgba(237,227,204,0.65); }
    .approach-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 6vw; align-items: start;
    }
    .approach-left {}
    .approach-pillars { display: flex; flex-direction: column; gap: 0; }
    .pillar {
      padding: 2.5rem 0;
      border-bottom: 1px solid rgba(191,161,106,0.12);
      display: flex; gap: 2rem; align-items: flex-start;
    }
    .pillar:first-child { padding-top: 0; }
    .pillar:last-child { border-bottom: none; }
    .pillar-num {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.5rem; font-weight: 300;
      color: rgba(191,161,106,0.2); line-height: 1;
      flex-shrink: 0; width: 3rem;
    }
    .pillar-title {
      font-family: 'Cormorant Garamond', serif; font-size: 1.35rem;
      color: var(--gold-pale); margin-bottom: 0.5rem;
    }
    .pillar-text {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.87rem; line-height: 1.9;
      color: rgba(237,227,204,0.55);
    }
    .approach-right {
      position: sticky; top: 100px;
      background: rgba(191,161,106,0.06);
      border: 1px solid rgba(191,161,106,0.12);
      padding: 3rem;
    }
    .approach-quote {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.6rem; font-weight: 300; font-style: italic;
      color: var(--gold-pale); line-height: 1.5; margin-bottom: 2rem;
    }
    .approach-quote::before {
      content: '\201C';
      font-size: 4rem; color: var(--gold); opacity: 0.3;
      line-height: 0; vertical-align: -1.5rem;
      margin-right: 0.2rem;
    }
    .approach-stats { display: flex; flex-direction: column; gap: 1px; margin-top: 2rem; }
    .approach-stat {
      background: rgba(191,161,106,0.06);
      border-left: 2px solid var(--gold);
      padding: 1.2rem 1.5rem;
    }
    .approach-stat-num {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem; color: var(--gold); line-height: 1;
    }
    .approach-stat-label {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.72rem; color: rgba(237,227,204,0.45);
      margin-top: 0.2rem; letter-spacing: 0.05em;
    }

    /* ── NETWORK ── */
    #network { background: var(--gold-pale); }
    .network-intro-layout {
      display: grid; grid-template-columns: 1fr 1fr; gap: 6vw; margin-bottom: 5rem;
    }
    .network-intro-layout p.section-intro { margin-bottom: 0; }
    .network-details {
      display: flex; flex-direction: column; gap: 1.5rem;
    }
    .network-detail {
      display: flex; gap: 1.5rem; align-items: flex-start;
      padding: 1.5rem; background: white;
    }
    .network-detail-icon {
      font-family: 'Cormorant Garamond', serif; font-size: 2rem;
      color: var(--burgundy); opacity: 0.4; flex-shrink: 0; line-height: 1;
    }
    .network-detail-title {
      font-family: 'Cormorant Garamond', serif; font-size: 1.2rem;
      color: var(--burgundy); margin-bottom: 0.3rem;
    }
    .network-detail-text {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.85rem; line-height: 1.8; color: var(--ink-soft);
    }
    .network-regions {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2px;
    }
    .network-region {
      background: white; padding: 2rem 1.8rem;
      border-left: 3px solid transparent;
      transition: border-color 0.3s;
    }
    .network-region:hover { border-color: var(--gold); }
    .region-name {
      font-family: 'Cormorant Garamond', serif; font-size: 1.2rem;
      color: var(--burgundy); margin-bottom: 0.75rem;
    }
    .region-jurisdictions {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.8rem; color: var(--ink-soft); line-height: 1.8;
    }

    /* ── TEAM / ATTORNEY ── */
    #team { background: var(--cream); }
    .team-layout {
      display: grid; grid-template-columns: 1fr 2fr; gap: 8vw; align-items: start;
    }
    .team-photo-col { position: sticky; top: 100px; }
    .team-photo-frame {
      background: var(--ink);
      aspect-ratio: 3/4;
      position: relative; overflow: hidden;
      border: 1px solid var(--rule);
    }
    .team-photo-placeholder {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      background: linear-gradient(160deg, rgba(92,26,43,0.6), rgba(26,16,8,0.95));
    }
    .team-photo-placeholder img {
      width: 100%; height: 100%;
      object-fit: cover; object-position: center top;
      display: block;
    }
    .team-photo-initials {
      font-family: 'Cormorant Garamond', serif;
      font-size: 5rem; font-weight: 300; color: rgba(191,161,106,0.4);
    }
    .team-photo-caption {
      margin-top: 1.5rem;
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--ink-soft);
    }
    .team-bio-col {}
    .attorney-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2rem, 3.5vw, 3.2rem); font-weight: 300;
      color: var(--burgundy); line-height: 1.1; margin-bottom: 0.5rem;
    }
    .attorney-title {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--gold); margin-bottom: 2.5rem;
    }
    .attorney-bio {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.95rem; line-height: 1.95; color: var(--ink-soft);
      margin-bottom: 1.5rem;
    }
    .attorney-credentials {
      display: flex; flex-direction: column; gap: 0; margin: 2.5rem 0;
    }
    .credential {
      display: flex; gap: 2rem; padding: 1.2rem 0;
      border-bottom: 1px solid var(--rule);
      align-items: baseline;
    }
    .credential:first-child { border-top: 1px solid var(--rule); }
    .credential-label {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--gold); flex-shrink: 0; width: 7rem;
    }
    .credential-value {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.87rem; color: var(--ink-soft); line-height: 1.6;
    }
    .attorney-areas {
      display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem;
    }
    .attorney-area {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--burgundy); border: 1px solid var(--rule);
      padding: 0.4rem 0.9rem;
    }

    /* ── JURISDICTIONS ── */
    #jurisdictions { background: var(--burgundy); }
    #jurisdictions h2.section-title { color: var(--gold-pale); }
    #jurisdictions .section-label { color: var(--gold); }
    #jurisdictions p.section-intro { color: rgba(237,227,204,0.7); }
    .jur-simple-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2px;
    }
    .jur-simple-card {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(191,161,106,0.1);
      padding: 2rem 1.8rem;
      transition: background 0.3s, border-color 0.3s;
    }
    .jur-simple-card:hover {
      background: rgba(191,161,106,0.08);
      border-color: rgba(191,161,106,0.3);
    }
    .jur-simple-name {
      font-family: 'Cormorant Garamond', serif; font-size: 1.3rem;
      color: var(--gold-pale); margin-bottom: 0.5rem;
    }
    .jur-simple-use {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.78rem; color: rgba(191,161,106,0.55); line-height: 1.7;
    }
    .jur-cta {
      margin-top: 4rem; text-align: center;
    }
    .jur-cta p {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.87rem; color: rgba(237,227,204,0.5);
      margin-bottom: 1.5rem;
    }

    /* ── CONTACT ── */
    #contact { background: var(--cream); }
    .contact-layout {
      display: grid; grid-template-columns: 1fr 1fr; gap: 8vw; align-items: start;
    }
    .contact-info {}
    .contact-info h3 {
      font-family: 'Cormorant Garamond', serif; font-size: 1.5rem;
      color: var(--burgundy); margin-bottom: 1.5rem;
    }
    .contact-info p {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.9rem; line-height: 1.9; color: var(--ink-soft);
      margin-bottom: 2.5rem;
    }
    .contact-items { display: flex; flex-direction: column; gap: 1.5rem; }
    .contact-item {
      display: flex; gap: 1.25rem; align-items: flex-start;
    }
    .contact-item-label {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--gold); flex-shrink: 0; width: 5rem; padding-top: 0.1rem;
    }
    .contact-item-value {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.9rem; color: var(--ink-soft); line-height: 1.6;
    }
    .contact-item-value a {
      color: var(--burgundy); text-decoration: none;
      transition: color 0.2s;
    }
    .contact-item-value a:hover { color: var(--gold); }
    .contact-calendly {
      background: var(--ink);
      padding: 3.5rem;
      display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem;
    }
    .contact-calendly-eyebrow {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.62rem; letter-spacing: 0.3em; text-transform: uppercase;
      color: var(--gold);
    }
    .contact-calendly h3 {
      font-family: 'Cormorant Garamond', serif; font-size: 1.8rem; font-weight: 300;
      color: var(--gold-pale); line-height: 1.3;
    }
    .contact-calendly p {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.87rem; line-height: 1.85;
      color: rgba(237,227,204,0.55);
    }
    .contact-note {
      font-family: 'Jost', sans-serif; font-weight: 300;
      font-size: 0.72rem; color: rgba(237,227,204,0.3);
      border-top: 1px solid rgba(191,161,106,0.12);
      padding-top: 1.5rem; margin-top: 0.5rem; line-height: 1.7;
      font-style: italic;
    }

